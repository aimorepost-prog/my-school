# ============================================================
# .env.local テンプレート
# このファイルをコピーして .env.local を作成し、各値を埋めてください
# .env.local は .gitignore で除外されています
# ============================================================

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage（画像アップロード用。デフォルト: images）
SUPABASE_STORAGE_BUCKET=images

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Resend ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
# お問い合わせ受信通知の送り先（管理者のメールアドレス）
ADMIN_NOTIFY_EMAIL=

# 領収書・メールの発行元名（DB未設定時のフォールバック）
RECEIPT_ISSUER_NAME=My Stage　神谷京花

# ---------- App ----------
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------- Cron ----------
# Vercel Cron 用の認証トークン（任意の長いランダム文字列を設定）
CRON_SECRET=

# ---------- Admin ----------
# 管理画面（/admin）のログインパスワード
ADMIN_PASSWORD=
# セッション署名用シークレット（未設定時は ADMIN_PASSWORD を使用）
ADMIN_SESSION_SECRET=
